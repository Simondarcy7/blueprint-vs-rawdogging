+import { describe, expect, it } from 'vitest';
+import { accountLeaseWriteGuard, grantAccountLease, registerAccountLease } from './accountLeaseGuard';
+
+describe('account lease write fencing', () => {
+  it('keeps unregistered native namespaces writable', () => {
+    const guard = accountLeaseWriteGuard('lease-test-unmanaged');
+    expect(guard).not.toThrow();
+    expect(guard).not.toThrow();
+  });
+
+  it('fences a writer created before its namespace becomes managed', () => {
+    const name = 'lease-test-late-registration';
+    const oldWriter = accountLeaseWriteGuard(name);
+    expect(oldWriter).not.toThrow();
+    registerAccountLease(name);
+    expect(oldWriter).toThrow('paused');
+    const revoke = grantAccountLease(name);
+    expect(oldWriter).toThrow('paused');
+    expect(accountLeaseWriteGuard(name)).not.toThrow();
+    revoke();
+  });
+
+  it('does not promote a waiting writer when a lease is granted', () => {
+    const name = 'lease-test-waiting';
+    registerAccountLease(name);
+    const waitingWriter = accountLeaseWriteGuard(name);
+    const revoke = grantAccountLease(name);
+    expect(waitingWriter).toThrow('paused');
+    expect(accountLeaseWriteGuard(name)).not.toThrow();
+    revoke();
+  });
+
+  it('keeps revoked writers fenced after reacquisition and ignores stale revocation', () => {
+    const name = 'lease-test-reacquired';
+    registerAccountLease(name);
+    const revokeFirst = grantAccountLease(name);
+    const firstWriter = accountLeaseWriteGuard(name);
+    expect(firstWriter).not.toThrow();
+    revokeFirst();
+    expect(firstWriter).toThrow('paused');
+    const revokeSecond = grantAccountLease(name);
+    const secondWriter = accountLeaseWriteGuard(name);
+    revokeFirst();
+    expect(firstWriter).toThrow('paused');
+    expect(secondWriter).not.toThrow();
+    revokeSecond();
+    expect(secondWriter).toThrow('paused');
+  });
+});

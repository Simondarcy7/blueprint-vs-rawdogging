 import { withDeadline } from '@/foundation/async/asyncDeadline';
 
 export const launchUpdateWindowMs = 6000;
+
+/** Once any gate opens the app, remounts must never re-enable automatic reload. */
+export function createLaunchUpdateSession(now: () => number = Date.now) {
+  const deadline = now() + launchUpdateWindowMs;
+  let state: 'opening' | 'interactive' | 'reloading' = 'opening';
+  const listeners = new Set<() => void>();
+  const change = (next: typeof state) => {
+    if (next === state) return;
+    state = next;
+    for (const listener of listeners) listener();
+  };
+  return {
+    getSnapshot: () => state,
+    subscribe(listener: () => void) {
+      listeners.add(listener);
+      return () => { listeners.delete(listener); };
+    },
+    remainingMs: () => Math.max(0, deadline - now()),
+    isReady: () => state === 'interactive' || (state === 'opening' && now() >= deadline),
+    isReloading: () => state === 'reloading',
+    canApply: () => state === 'opening' && now() < deadline,
+    open() { if (state !== 'reloading') change('interactive'); },
+    beginReload() { change('reloading'); },
+    reloadFailed() { change('interactive'); },
+  };
+}
+
+export const launchUpdateSession = createLaunchUpdateSession();
+

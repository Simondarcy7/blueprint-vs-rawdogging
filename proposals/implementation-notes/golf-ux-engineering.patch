diff --git a/mobile/src/components/overlayReturnFocus.web.test.ts b/mobile/src/components/overlayReturnFocus.web.test.ts
new file mode 100644
index 00000000..45e8c3aa
--- /dev/null
+++ b/mobile/src/components/overlayReturnFocus.web.test.ts
@@ -0,0 +1,59 @@
+// @vitest-environment jsdom
+import { afterEach, expect, test, vi } from 'vitest';
+import { captureOverlayReturnFocus } from './overlayReturnFocus';
+
+afterEach(() => { vi.restoreAllMocks(); document.body.replaceChildren(); });
+
+function fixture(markup: string) {
+  document.body.innerHTML = markup;
+  let frame: FrameRequestCallback | undefined;
+  vi.spyOn(window, 'requestAnimationFrame').mockImplementation(callback => { frame = callback; return 1; });
+  const trigger = document.querySelector<HTMLButtonElement>('#trigger')!;
+  trigger.focus();
+  return { trigger, finish: () => frame?.(0) };
+}
+
+test.each(['<a href="#next" id="destination">Next</a>', '<h2 tabindex="-1" id="destination">Next</h2>'])(
+  'preserves deliberate focus on %s after closing starts', markup => {
+    const { finish } = fixture(`<button id="trigger">Menu</button>${markup}`);
+    captureOverlayReturnFocus()();
+    const destination = document.querySelector<HTMLElement>('#destination')!;
+    destination.focus();
+    finish();
+    expect(document.activeElement).toBe(destination);
+  },
+);
+test('preserves destination focus set before the close callback runs', () => {
+  const { finish } = fixture('<button id="trigger">Menu</button><h2 tabindex="-1" id="destination">Next</h2>');
+  const restore = captureOverlayReturnFocus();
+  const destination = document.querySelector<HTMLElement>('#destination')!;
+  destination.focus();
+  restore();
+  finish();
+  expect(document.activeElement).toBe(destination);
+});
+test.each(['inert', 'hidden', 'aria-hidden', 'aria-disabled'])('does not restore into an ancestor made %s', attribute => {
+  const { trigger, finish } = fixture('<section id="region"><button id="trigger">Menu</button></section>');
+  const focus = vi.spyOn(trigger, 'focus');
+  captureOverlayReturnFocus()();
+  document.querySelector('#region')!.setAttribute(attribute, attribute.startsWith('aria-') ? 'true' : '');
+  finish();
+  expect(focus).not.toHaveBeenCalled();
+});
+test('does not restore to a button disabled by its enclosing fieldset', () => {
+  const { trigger, finish } = fixture('<fieldset id="region"><button id="trigger">Menu</button></fieldset>');
+  const focus = vi.spyOn(trigger, 'focus');
+  captureOverlayReturnFocus()();
+  document.querySelector('#region')!.setAttribute('disabled', '');
+  finish();
+  expect(focus).not.toHaveBeenCalled();
+});
+test('restores a removed modal to the still-connected trigger', () => {
+  const { trigger, finish } = fixture('<button id="trigger">Menu</button><div role="dialog" aria-modal="true"><button id="close">Close</button></div>');
+  const restore = captureOverlayReturnFocus();
+  document.querySelector<HTMLElement>('#close')!.focus();
+  restore();
+  document.querySelector('[role="dialog"]')!.remove();
+  finish();
+  expect(document.activeElement).toBe(trigger);
+});
